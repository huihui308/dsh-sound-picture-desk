{
  "name": "dsh-sound-picture-desk",
  "version": "0.1.0",
  "private": true,
  "description": "声画工作台：一个主题或一本书，在面板里走完选题、写稿、定人物、配音、分镜、合成，产出 1080×1920 竖屏 mp4 与 SRT 字幕。写稿用 DSH 模型，旁白 MiMo 多音色，分镜接 OpenAI 兼容或本机生图；每段可改，改完只重做该段。",
  "type": "module",
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "src",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ]
    }
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "story-video",
    "tts"
  ],
  "license": "MIT"
}
